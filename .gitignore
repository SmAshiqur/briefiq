# =====================================================================
# BriefIQ root .gitignore
#
# This is a monorepo with two subprojects:
#   - briefiq-api/   (NestJS backend — Node + TypeScript)
#   - BriefIQ-iOS/   (SwiftUI client — Xcode)
#
# Each subproject has its own .gitignore for project-specific rules.
# This root .gitignore is a SAFETY NET that catches the common stuff
# at any depth in the repo so nothing leaks accidentally.
# =====================================================================


# ---------- Node / TypeScript ----------
# node_modules anywhere in the tree (we never commit deps).
node_modules/

# Compiled / bundled output.
dist/
build/
out/

# Type-check / build caches.
*.tsbuildinfo
.tsbuildinfo

# Drizzle Studio cache.
.drizzle/

# transformers.js model cache (downloaded on first run, ~50MB).
.cache/


# ---------- Environment / secrets ----------
# Never commit real env files. Commit .env.example instead.
.env
.env.local
.env.*.local
*.env
!*.env.example


# ---------- Xcode / Swift ----------
# Xcode user-specific state (per-developer, never shared).
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata
*.xcodeproj/xcuserdata
*.xcodeproj/project.xcworkspace/xcuserdata

# Swift Package Manager.
.swiftpm/
Package.resolved

# Build outputs.
DerivedData/
*.ipa
*.dSYM
*.dSYM.zip

# Xcode project file is regenerated by xcodegen from project.yml.
# Source of truth is project.yml — don't commit the generated .xcodeproj.
BriefIQ-iOS/BriefIQ.xcodeproj/


# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ---------- Testing / coverage ----------
coverage/
.nyc_output/
*.lcov


# ---------- OS junk ----------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*


# ---------- Editor / IDE ----------
# JetBrains
.idea/

# VS Code (keep .vscode/ if you ever ship shared workspace settings;
# for now we ignore it because nothing in there is project-wide).
.vscode/

# Sublime / Vim / Emacs swap files.
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~


# ---------- Misc ----------
# Backup folders.
backups/

# Local scratch / personal notes — uncomment if you keep a scratch dir.
# scratch/
# notes.local.md
