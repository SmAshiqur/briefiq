# ── BriefIQ backend env ──
# Copy this to .env and fill in real values for local dev.

# ── Server ──
NODE_ENV=development
PORT=3000

# ── Postgres (Neon free tier in prod, local docker for dev) ──
# Local docker compose default:
DATABASE_URL=postgres://briefiq:briefiq@localhost:5432/briefiq

# ── Redis (Upstash free tier in prod, local docker for dev) ──
REDIS_URL=redis://localhost:6379

# ── JWT (used to mint our own session tokens after Apple sign-in) ──
# Generate a strong secret for prod, e.g. `openssl rand -base64 32`
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=30d

# ── LLM gateway (Vercel AI SDK -> OpenRouter) ──
# Prototype: openrouter/free auto-router. Production: paid model name.
# See https://openrouter.ai/keys for an API key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-replace-me
LLM_MODEL=openrouter/auto
# Pinned cascade for free-tier fallback (comma-separated, in order)
LLM_FREE_CASCADE=deepseek/deepseek-chat:free,qwen/qwen3-coder-480b:free,openai/gpt-oss-20b:free

# ── Search ──
# Tavily free tier: https://tavily.com/
TAVILY_API_KEY=tvly-replace-me
# Firecrawl is optional fallback for paywalled / JS-heavy pages
FIRECRAWL_API_KEY=

# ── Apple Sign-In (production setup; safe to leave blank for now) ──
# These come from the Apple Developer portal.
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── APNs (production push; safe to leave blank for now) ──
# Use the .p8 key from Apple Developer.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.briefiq.app
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false
