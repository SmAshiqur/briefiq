# ── BriefIQ backend env ──

# ── Server ──
NODE_ENV=development
PORT=3000

# ── Postgres (local Docker) ──
DATABASE_URL=postgres://briefiq:briefiq@localhost:5432/briefiq

# ── Redis (local Docker) ──
REDIS_URL=redis://localhost:6379

# ── JWT ──
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ── LLM gateway ──
LLM_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated OpenRouter keys (see getOpenRouterKeys() in env.ts)
OPENROUTER_API_KEYS=
LLM_API_KEY=
LLM_MODEL=openrouter/auto
LLM_FREE_CASCADE=deepseek/deepseek-chat:free,qwen/qwen3-coder-480b:free,openai/gpt-oss-20b:free

# ── Paid fallback (disabled) ──
PAID_LLM_BASE_URL=https://openrouter.ai/api/v1
PAID_LLM_API_KEY=
PAID_LLM_MODEL=

# ── Search ──
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# ── Apple Sign-In (optional) ──
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── APNs (optional) ──
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.briefiq.app
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false

# ── Monitoring (optional) ──
# SENTRY_DSN=https://...@sentry.io/...
# OPS_READ_TOKEN=change-me-in-prod
