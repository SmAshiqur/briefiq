# ── BriefIQ backend env ──
# Copy this to .env and fill in real values for local dev.
#
# `npm run dev` reads .env automatically (via dotenv inside @nestjs/config).
# The app validates this with Zod at boot — missing keys fail fast with a
# readable error pointing at the offending variable.

# ── Server ──
NODE_ENV=development
PORT=3000

# ── Postgres (Neon free tier in prod, local docker for dev) ──
# Local docker compose default:
DATABASE_URL=postgres://briefiq:briefiq@localhost:5432/briefiq

# ── Redis (Upstash free tier in prod, local docker for dev) ──
REDIS_URL=redis://localhost:6379

# ── JWT (used to mint our own session tokens after Apple sign-in) ──
# Generate a strong secret for prod, e.g. `openssl rand -base64 32`
JWT_SECRET=dev-only-change-me-32chars-min
JWT_EXPIRES_IN=30d

# ── LLM gateway: OpenRouter via Vercel AI SDK ──
# All LLM calls go through one OpenAI-compatible endpoint. Swap free <-> paid
# by editing LLM_MODEL (and PAID_LLM_* below). No code change ever.
LLM_BASE_URL=https://openrouter.ai/api/v1

# ── Multi-key rotation (the main throughput knob) ──
# Comma-separated list of OpenRouter API keys. The KeyRotator picks the
# least-loaded non-cooldown key on every LLM call and trips a 5-minute
# cooldown on any key that 429s. Stacking N free accounts gives roughly
# N× the effective daily quota at zero cost.
#
# Free-tier limits (per OpenRouter account):
#   - 20 requests / minute
#   - 200 requests / day  (or 1,000 / day after a one-time $10 deposit)
#
# Get keys at https://openrouter.ai/keys (one per Google account).
OPENROUTER_API_KEYS=sk-or-v1-replace-1,sk-or-v1-replace-2,sk-or-v1-replace-3

# Legacy single-key fallback. Used ONLY if OPENROUTER_API_KEYS is empty.
# Keep blank in new setups.
LLM_API_KEY=

# Default model name. `openrouter/auto` is the free auto-router that picks
# from current free models supporting tool-calling + structured output.
# When you go paid: change to e.g. anthropic/claude-3.5-sonnet
LLM_MODEL=openrouter/auto

# Pinned cascade walked when the default model fails (auth, availability,
# 429 across all keys). Comma-separated, in order of preference.
LLM_FREE_CASCADE=deepseek/deepseek-chat:free,qwen/qwen3-coder-480b:free,openai/gpt-oss-20b:free

# ── Paid fallback (optional, last resort) ──
# When set, the cascade tries this AFTER every free key + model combo has
# failed or hit cooldown. Useful in production where "no fresh briefing"
# is worse than spending a few cents.
#
# Leave PAID_LLM_API_KEY + PAID_LLM_MODEL blank to enforce free-only mode
# (silence-is-a-feature: degrade gracefully instead of incurring cost).
#
# Example for Anthropic via OpenRouter (paid):
#   PAID_LLM_API_KEY=sk-or-v1-paid-key
#   PAID_LLM_MODEL=anthropic/claude-3.5-haiku
#
# Example for direct Anthropic SDK:
#   PAID_LLM_BASE_URL=https://api.anthropic.com/v1
#   PAID_LLM_API_KEY=sk-ant-...
#   PAID_LLM_MODEL=claude-3-5-haiku-latest
PAID_LLM_BASE_URL=https://openrouter.ai/api/v1
PAID_LLM_API_KEY=
PAID_LLM_MODEL=

# ── Search ──
# Tavily free tier: 1k requests / month — https://tavily.com/
TAVILY_API_KEY=tvly-replace-me
# Firecrawl is optional fallback for paywalled / JS-heavy pages
FIRECRAWL_API_KEY=

# ── Apple Sign-In (production setup; safe to leave blank for now) ──
# These come from the Apple Developer portal.
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── APNs (production push; safe to leave blank for now) ──
# Use the .p8 key from Apple Developer.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.briefiq.app
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false
